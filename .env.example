# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://gojo_admin:secret_password@localhost:5432/gojo_innovation_db?schema=public"

# Headless CMS (Sanity / Strapi / Custom API)
NEXT_PUBLIC_CMS_TYPE="mock" # Options: 'mock' | 'sanity' | 'strapi' | 'api'
CMS_PROJECT_ID="gojo-innovation-cms"
CMS_DATASET="production"
CMS_API_TOKEN="cms_read_write_token_placeholder"

# Site URLs & Deployment
NEXT_PUBLIC_SITE_URL="https://www.gojoinnovation.com"
NEXT_PUBLIC_SITE_NAME="GOJO Innovation Pvt. Ltd."

# Analytics & Event Tracking
NEXT_PUBLIC_ANALYTICS_ID="G-GOJOINNOVATION"
NEXT_PUBLIC_ENABLE_ANALYTICS="true"

# GojoMe & Microservices APIs
GOJOME_API_URL="https://api.gojome.health/v1"
BIOHEED_PORTAL_API="https://api.bioheed.com/v1"

# Authentication & GOJO ID
AUTH_SECRET="enterprise_super_secret_signing_key_gojo_id"
NEXTAUTH_URL="https://www.gojoinnovation.com"
